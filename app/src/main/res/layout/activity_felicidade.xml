<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Questionário da Felicidade"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atividade Atual:"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbEstudando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estudando/Trabalhando/Folga" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horas de Sono:"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgSono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbSono1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 a 3h" />
            <RadioButton
                android:id="@+id/rbSono2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 a 8h" />
            <RadioButton
                android:id="@+id/rbSono3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9 a 12h" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nível de Estresse:"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgEstresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbEstresse1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 a 3" />
            <RadioButton
                android:id="@+id/rbEstresse2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 a 7" />
            <RadioButton
                android:id="@+id/rbEstresse3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 a 10" />
        </RadioGroup>

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Calcular" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Voltar"
            style="@style/Widget.AppCompat.Button.Borderless" />

    </LinearLayout>
</ScrollView>